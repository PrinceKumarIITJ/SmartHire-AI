# --- LLM providers (at least one key is required) -------------------------
# Primary provider: "gemini" or "groq". The other, if configured, is the automatic fallback.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# --- Email delivery (optional; without it, sends are simulated and logged) -
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
HR_COMPANY_NAME=SmartHire AI Inc.

# --- API -------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed browser origins, e.g. https://smarthire.vercel.app
CORS_ORIGINS=*
DATABASE_URL=sqlite+aiosqlite:///./smarthire.db
SHORTLIST_THRESHOLD=0.70
MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=50
RESUME_PARSE_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# cpu or cuda; leave unset to auto-detect
# EMBEDDING_DEVICE=cpu

# --- Frontend (frontend/.env.local) ----------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
